# TripLens examples: local structured evidence, no credentials required.
# Change to "http" to use the Python /api/analyze endpoint.
VITE_ANALYST_PROVIDER=local

# Workspace data directory in the Python server environment (default: ./data).
# L5_DATA_DIR=/path/to/l5-data

# Set these in the Python server environment, never in a VITE_ variable.
# TRIPLENS_MODEL_ENDPOINT=https://your-provider/v1/chat/completions
# TRIPLENS_MODEL=your-model-id
# TRIPLENS_MODEL_API_KEY=your-secret
